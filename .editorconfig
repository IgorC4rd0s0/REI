root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
continuation_indent_size = 4

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.{js,css,html,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
